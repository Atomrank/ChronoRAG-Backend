# ---------- LLM provider: azure | gemini ----------
# Deployment strings below may also carry a prefix to pick a provider per call:
# "azure:<deployment>", "gemini:<model>", "local:<model>".
LLM_PROVIDER=azure

# ---------- Google Gemini (OpenAI-compatible endpoint) ----------
# Comma/newline-separated keys, rotated round-robin. A key that returns 429 cools down for the
# server's retry delay; a key that returns 401/402/403 is dropped until restart. Every rotation
# is written to build_events (llm_key_rate_limited / llm_key_disabled / llm_transient_error).
GEMINI_API_KEYS=
GEMINI_CHAT_MODEL=gemini-3.8-flash
# tried in order when the chat model is overloaded (5xx/timeouts); logged as llm_model_fallback.
# Never applied to explicitly named judge/gold models.
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash
# called with dimensions=EMBED_DIM; switching embedding provider requires re-ingesting documents
GEMINI_EMBED_MODEL=gemini-embedding-001
# "" = model default; thinking tokens are billed and share the output cap
GEMINI_REASONING_EFFORT=low
GEMINI_THINKING_HEADROOM=2048

# ---------- Azure OpenAI ----------
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=replace_me
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_CHAT_DEPLOYMENT=gpt-4o
AZURE_EMBED_DEPLOYMENT=text-embedding-3-small
# model used ONLY to propose gold questions (ideally long-context and different from the chat model)
AZURE_GOLD_DEPLOYMENT=gpt-4o
# (with LLM_PROVIDER=gemini, e.g. AZURE_GOLD_DEPLOYMENT=gemini:gemini-3.1-pro-preview)
# automatic gold: judges that must all agree (comma-separated; "local:<model>" = vLLM server,
# "gemini:<model>" = Gemini, e.g. GOLD_JUDGES=gemini:gemini-3.8-flash)
GOLD_JUDGES=gpt-4o
# optional judge that reads the whole book (needed to keep cannot_determine gold), e.g. gpt-4.1
GOLD_FULLTEXT_JUDGE=
# max chars the gold model reads in one call (gpt-4o: 300000; 1M-context models: 3000000)
GOLD_MAX_INPUT_CHARS=300000

# optional: local OpenAI-compatible server (vLLM) for windows the Azure filter blocks
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
EMBED_DIM=1536

# ---------- Postgres ----------
PG_DSN=postgresql://kaalkram:kaalkram_dev@localhost:5433/kaalkram

# ---------- Neo4j ----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=kaalkram_dev

# ---------- Pipeline tuning ----------
CONCURRENCY=5
WINDOW_SIZE=10
WINDOW_OVERLAP=2
NAIVE_CHUNK_CHARS=1200
NAIVE_CHUNK_OVERLAP=200
NAIVE_TOP_K=8
PASS2_BATCH_SIZE=2

# ---------- Paths ----------
UPLOAD_DIR=./data/uploads
CACHE_DIR=./data/cache

# ---------- Frontend ----------
NEXT_PUBLIC_API_BASE=http://localhost:8000
